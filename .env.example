# Copiar este archivo a .env y completar con credenciales reales.
# .env NUNCA debe subirse al repositorio (ver .gitignore).

# --- MySQL (staging_steam) ---
MYSQL_ROOT_PASSWORD=cambia_esto

# --- PostgreSQL (Data Warehouse, esquema dw) ---
POSTGRES_USER=cambia_esto
POSTGRES_PASSWORD=cambia_esto
POSTGRES_DB=cambia_esto

# --- Metadatos internos de Airflow (base de datos separada del DW) ---
AIRFLOW_DB_PASSWORD=cambia_esto
AIRFLOW_UID=50000
AIRFLOW_ADMIN_USER=admin
AIRFLOW_ADMIN_PASSWORD=cambia_esto
